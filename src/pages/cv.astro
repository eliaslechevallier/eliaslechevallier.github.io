---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { profile, education, experience } from '../data/cv';
---

<BaseLayout title="CV" description="My profile, education, and work experience.">
  <div class="flex items-center justify-between gap-4">
    <h1 class="text-3xl font-extrabold text-ink">Profile</h1>
    <a
      href={site.resumeUrl}
      class="shrink-0 rounded-full border border-ink/20 px-4 py-2 text-sm font-semibold text-ink transition-colors hover:border-ink/40"
    >
      Download PDF
    </a>
  </div>
  <p class="mt-4 max-w-2xl leading-relaxed text-muted">{profile}</p>

  <h2 class="mt-12 text-2xl font-extrabold text-ink">Education</h2>
  <ol class="mt-6 border-l-2 border-accent/40 pl-6">
    {
      education.map((item) => (
        <li class="relative pb-8 last:pb-0">
          <span class="absolute -left-[1.65rem] top-1 h-3 w-3 rounded-full bg-accent" />
          <h3 class="font-semibold text-ink">{item.title}</h3>
          <p class="mt-0.5 text-sm text-muted">
            {item.period} · {item.place}
          </p>
        </li>
      ))
    }
  </ol>

  <h2 class="mt-12 text-2xl font-extrabold text-ink">Experience</h2>
  <ol class="mt-6 border-l-2 border-accent/40 pl-6">
    {
      experience.map((item) => (
        <li class="relative pb-8 last:pb-0">
          <span class="absolute -left-[1.65rem] top-1 h-3 w-3 rounded-full bg-accent" />
          <h3 class="font-semibold text-ink">{item.title}</h3>
          <p class="mt-0.5 text-sm text-muted">
            {item.period} · {item.place}
          </p>
          <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted">
            {item.description}
          </p>
        </li>
      ))
    }
  </ol>
</BaseLayout>
