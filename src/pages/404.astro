---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found">
  <h1 class="text-4xl font-extrabold text-ink">404</h1>
  <p class="mt-4 text-muted">This page doesn't exist. Let's get you back home.</p>
  <a
    href="/"
    class="mt-6 inline-block rounded-full bg-highlight px-5 py-2.5 text-sm font-semibold text-ink transition-colors hover:bg-highlight/70"
  >
    Back to home
  </a>
</BaseLayout>
