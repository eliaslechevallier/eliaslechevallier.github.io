---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site } from '../data/site';
import { allProjects } from '../data/projects';

const featured = allProjects.filter((p) => p.featured);
---

<BaseLayout title="Home">

  <!-- Flags and university logo -->
  <div class="flex justify-end items-center gap-5 mb-8">

    <img
      src="/france.png"
      alt="France"
      class="h-8 w-auto rounded-sm object-contain"
    />

    <img
      src="/colombia.png"
      alt="Colombia"
      class="h-8 w-auto rounded-sm object-contain"
    />

    <img
      src="/mcgill.png"
      alt="McGill University"
      class="h-12 w-auto object-contain"
    />

  </div>

  <p class="text-lg">{site.greeting}</p>

  <h1 class="mt-2 text-4xl font-extrabold tracking-tight text-ink sm:text-5xl">
    {site.tagline}
  </h1>

  <h2 class="mt-2 text-2xl font-bold text-ink sm:text-3xl">{site.subtitle}</h2>

  <p class="mt-6 w-full leading-relaxed text-muted">{site.intro}</p>

  <div class="mt-8 flex flex-wrap gap-3">
  <a
    href="/Resume_Elias_Lechevallier_Masters.pdf"
    target="_blank"
    rel="noopener noreferrer"
    class="rounded-full border border-ink/20 px-5 py-2.5 text-sm font-semibold text-ink transition-colors hover:border-ink/40"
  >
    Resume/CV
  </a>
  <a
    href="/contact"
    class="rounded-full bg-highlight px-5 py-2.5 text-sm font-semibold text-ink transition-colors hover:bg-highlight/70"
  >
    Let's connect!
  </a>
</div>

  <h2 class="mt-14 text-2xl font-bold text-ink">
  Featured Projects
</h2>

<div class="mt-6 grid grid-cols-3 gap-4">
  {featured.slice(0, 5).map((project) => (
    <ProjectCard project={project} />
  ))}
</div>

  <a
    href="/projects"
    class="mt-6 inline-block text-sm font-semibold text-accent hover:underline"
  >
    See all projects →
  </a>
</BaseLayout>
