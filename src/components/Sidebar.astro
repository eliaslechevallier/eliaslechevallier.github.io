---
import { site, nav, socials } from '../data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';

function isActive(href: string) {
  const clean = href.replace(/\/$/, '') || '/';
  return clean === path;
}

// Small inline icon set so the sidebar has zero external dependencies.
const ICONS: Record<string, string> = {
  github:
    '<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.73.5.98 5.24.98 11.52c0 4.94 3.2 9.13 7.65 10.61.56.1.76-.24.76-.54v-1.9c-3.11.68-3.77-1.5-3.77-1.5-.51-1.3-1.24-1.65-1.24-1.65-1.01-.7.08-.68.08-.68 1.12.08 1.71 1.15 1.71 1.15 1 1.71 2.62 1.22 3.26.93.1-.72.39-1.22.71-1.5-2.48-.28-5.09-1.24-5.09-5.51 0-1.22.44-2.21 1.15-2.99-.12-.28-.5-1.42.11-2.96 0 0 .94-.3 3.08 1.14a10.7 10.7 0 0 1 5.6 0c2.14-1.44 3.08-1.14 3.08-1.14.61 1.54.23 2.68.11 2.96.72.78 1.15 1.77 1.15 2.99 0 4.28-2.62 5.22-5.11 5.5.4.35.76 1.03.76 2.08v3.08c0 .3.2.65.77.54A11.03 11.03 0 0 0 23.02 11.5C23.02 5.24 18.27.5 12 .5Z"/></svg>',
  linkedin:
    '<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.03-1.85-3.03-1.86 0-2.14 1.45-2.14 2.94v5.66H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"/></svg>',
  twitter:
    '<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M18.9 2H22l-7.4 8.46L23.3 22h-6.8l-5.3-6.6L4.9 22H1.8l7.9-9.03L1 2h7l4.8 6.02L18.9 2Zm-1.2 18.2h1.9L7.4 3.7H5.4l12.3 16.5Z"/></svg>',
  mail:
    '<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="2.5" y="4.5" width="19" height="15" rx="2.3"/><path d="m3.5 6 8.5 6.5L20.5 6" stroke-linecap="round" stroke-linejoin="round"/></svg>',
};
---

<aside class="flex shrink-0 flex-col justify-between bg-panel px-6 py-8 md:w-64">
  <div>
    <a href="/" class="mb-8 flex justify-center md:justify-start">
      <img
        src={site.avatar}
        alt={site.name}
        class="h-24 w-24 rounded-full object-cover ring-1 ring-black/5"
        width="96"
        height="96"
      />
    </a>

    <nav>
      <ul class="space-y-1">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'block rounded-full px-4 py-2 text-sm font-medium transition-colors',
                  isActive(item.href)
                    ? 'bg-highlight text-ink'
                    : 'text-muted hover:bg-highlight/60 hover:text-ink',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <ul class="flex justify-center gap-4 pt-8 md:justify-start">
    {
      socials.map((s) => (
        <li>
          <a
            href={s.href}
            aria-label={s.label}
            target={s.href.startsWith('http') ? '_blank' : undefined}
            rel={s.href.startsWith('http') ? 'noopener noreferrer' : undefined}
            class="block text-ink/80 transition-colors hover:text-accent"
            set:html={ICONS[s.icon]}
          />
        </li>
      ))
    }
  </ul>
</aside>
